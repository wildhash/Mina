def test_confidence_scores_boundary_values():
    """Test confidence scores stay within valid range."""
    agent = MinaAgent()
    
    # Extreme low case
    low_product = ProductOption(
        name="Low Quality",
        price=500,
        retailer="Budget Store",
        url="http://test.com",
        specs={},
        reviews_summary="",
        rating=2.0
    )
    
    low_analysis = {
        "product": "Low Quality",
        "strengths": [],
        "weaknesses": ["Poor quality", "Bad reviews", "Limited features"],
        "fit_score": 10.0,
        "value_assessment": "Poor value"
    }
    
    scores = agent.calculate_confidence_scores([low_product], [low_analysis])
    
    assert 0 <= scores[0] <= 100


def test_multiple_retailers_in_results():
    """Test that products come from different retailers."""
    agent = MinaAgent()
    
    requirements = {
        "category": "laptop",
        "budget_max": 5000,
        "priorities": ["Performance"],
        "specific_needs": ""
    }
    
    products = agent.browse_retailers(requirements)
    
    retailers = {p.retailer for p in products}
    # Should have products from multiple retailers
    assert len(retailers) >= 2


def test_product_specs_completeness():
    """Test that products have complete specifications."""
    agent = MinaAgent()
    
    requirements = {
        "category": "laptop",
        "budget_max": 3000,
        "priorities": ["Performance"],
        "specific_needs": ""
    }
    
    products = agent.browse_retailers(requirements)
    
    for product in products:
        assert isinstance(product.specs, dict)
        assert len(product.specs) > 0
        # Laptops should have key specs
        assert any(key in str(product.specs).lower() 
                  for key in ["processor", "cpu", "ram", "storage", "memory"])


    # Run tests
    print("Running Mina Agent Tests...\n")
    
    tests = [
        ("Agent Initialization", test_agent_initialization),
        ("Product Categories", test_product_categories),
        ("Browse Retailers", test_browse_retailers),
        ("Claude Analysis", test_analyze_with_claude),
        ("Confidence Scores", test_confidence_scores),
        ("Generate Recommendations", test_generate_recommendations),
    ]
    
    passed = 0
    failed = 0
    
    for test_name, test_func in tests:
        try:
            test_func()
            print(f"✓ {test_name}")
            passed += 1
        except Exception as e:
            print(f"✗ {test_name}: {e}")
            failed += 1
    
    print(f"\n{'='*50}")
    print(f"Tests passed: {passed}/{len(tests)}")
    print(f"Tests failed: {failed}/{len(tests)}")
    print(f"{'='*50}\n")
    
    sys.exit(0 if failed == 0 else 1)