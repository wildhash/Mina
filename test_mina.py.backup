        specs={},
        reviews_summary="Mixed reviews",
        rating=4.2
    )
    
    analysis = {
        "product": "Product with Issues",
        "strengths": ["Good price"],
        "weaknesses": ["Limited features", "Average build quality"],
        "fit_score": 65.0,
        "value_assessment": "Fair value"
    }
    
    recommendations = agent.generate_recommendations([product], [analysis], [68.0])
    
    assert len(recommendations) == 1
    assert len(recommendations[0].cons) == 2
    assert "Limited features" in recommendations[0].cons


