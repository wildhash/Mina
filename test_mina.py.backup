def test_confidence_scores_multiple_products():
    """Test confidence score calculation for multiple products."""
    agent = MinaAgent()
    
    products = [
        ProductOption(
            name="Product A",
            price=1500,
            retailer="Store A",
            url="http://test.com/a",
            specs={"feature": "excellent"},
            reviews_summary="Great product",
            rating=4.8
        ),
        ProductOption(
            name="Product B",
            price=1800,
            retailer="Store B",
            url="http://test.com/b",
            specs={"feature": "good"},
            reviews_summary="Decent product",
            rating=4.3
        )
    ]
    
    analyses = [
        {
            "product": "Product A",
            "strengths": ["High quality", "Great reviews"],
            "weaknesses": [],
            "fit_score": 90.0,
            "value_assessment": "Excellent"
        },
        {
            "product": "Product B",
            "strengths": ["Good value"],
            "weaknesses": ["Average performance"],
            "fit_score": 70.0,
            "value_assessment": "Fair"
        }
    ]
    
    scores = agent.calculate_confidence_scores(products, analyses)
    
    assert len(scores) == 2
    assert all(0 <= score <= 100 for score in scores)
    # Product A should have higher confidence
    assert scores[0] > scores[1]


def test_confidence_scores_edge_cases():
    """Test confidence scores with edge case inputs."""
    agent = MinaAgent()
    
    # Product with missing reviews
    product = ProductOption(
        name="Minimal Data Product",
        price=1000,
        retailer="Test",
        url="http://test.com",
        specs={},
        reviews_summary="",
        rating=3.0
    )
    
    analysis = {
        "product": "Minimal Data Product",
        "strengths": [],
        "weaknesses": ["Limited data", "Low rating", "Poor reviews"],
        "fit_score": 50.0,
        "value_assessment": "Unknown"
    }
    
    scores = agent.calculate_confidence_scores([product], [analysis])
    
    assert len(scores) == 1
    assert scores[0] >= 0
    # Should have lower confidence due to missing data
    assert scores[0] < 70


def test_generate_recommendations_sorting():
    """Test that recommendations are sorted by confidence score."""
    agent = MinaAgent()
    
    products = [
        ProductOption(
            name="Product Low",
            price=1000,
            retailer="Store",
            url="http://test.com/1",
            specs={},
            reviews_summary="OK",
            rating=4.0
        ),
        ProductOption(
            name="Product High",
            price=1500,
            retailer="Store",
            url="http://test.com/2",
            specs={"premium": "yes"},
            reviews_summary="Excellent",
            rating=4.9
        )
    ]
    
    analyses = [
        {
            "product": "Product Low",
            "strengths": ["Affordable"],
            "weaknesses": ["Basic"],
            "fit_score": 60.0,
            "value_assessment": "Basic"
        },
        {
            "product": "Product High",
            "strengths": ["Premium", "Excellent"],
            "weaknesses": [],
            "fit_score": 95.0,
            "value_assessment": "Excellent"
        }
    ]
    
    confidence_scores = [65.0, 92.0]
    
    recommendations = agent.generate_recommendations(products, analyses, confidence_scores)
    
    assert len(recommendations) == 2
    # Should be sorted by confidence (highest first)
    assert recommendations[0].confidence_score >= recommendations[1].confidence_score
    assert recommendations[0].product.name == "Product High"


def test_generate_recommendations_reasoning():
    """Test that recommendations include proper reasoning."""
    agent = MinaAgent()
    
    product = ProductOption(
        name="Test Product",
        price=2000,
        retailer="Store",
        url="http://test.com",
        specs={"feature": "premium"},
        reviews_summary="Great",
        rating=4.7
    )
    
    analysis = {
        "product": "Test Product",
        "strengths": ["High quality", "Great value"],
        "weaknesses": [],
        "fit_score": 85.0,
        "value_assessment": "Excellent value for money"
    }
    
    recommendations = agent.generate_recommendations([product], [analysis], [87.5])
    
    assert len(recommendations) == 1
    assert "87.5%" in recommendations[0].reasoning
    assert "85" in recommendations[0].reasoning
    assert len(recommendations[0].reasoning) > 50  # Should have substantial reasoning


def test_generate_recommendations_with_cons():
    """Test recommendations include cons when present."""
    agent = MinaAgent()
    
    product = ProductOption(
        name="Product with Issues",
        price=1500,
        retailer="Store",
