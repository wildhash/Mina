def test_analyze_with_claude_multiple_priorities():
    """Test Claude analysis with multiple priorities."""
    agent = MinaAgent()
    
    products = [
        ProductOption(
            name="High Performance Laptop",
            price=2500,
            retailer="Tech Store",
            url="http://test.com",
            specs={"processor": "Intel i9-13900H", "ram": "32GB", "battery": "Up to 13 hours"},
            reviews_summary="Excellent performance",
            rating=4.7
        )
    ]
    
    requirements = {
        "category": "laptop",
        "budget_max": 3000,
        "priorities": ["Performance", "Battery Life", "Build Quality"],
        "specific_needs": "Software development"
    }
    
    analyses = agent.analyze_with_claude(products, requirements)
    
    assert len(analyses) == 1
    assert analyses[0]["product"] == "High Performance Laptop"
    assert "strengths" in analyses[0]
    assert "weaknesses" in analyses[0]
    assert "fit_score" in analyses[0]
    assert 0 <= analyses[0]["fit_score"] <= 100


